{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "/home/lemontree/.config/fastfetch/anime-2.txt",

        "padding": {
            "top": 2,
            "left": 3,
            "right": 3
        }
    },
    "modules": [
        {
      "type": "title",
      "format": "▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄"
        },
        {
      "type": "title",
      "format": "█▄─▄▄─██▀▄─██─▄▄▄▄█─▄─▄─███▄─▄▄─█▄─▄▄─█─▄─▄─█─▄▄▄─█─█─█"
        },
        {
      "type": "title",
      "format": "██─▄████─▀─██▄▄▄▄─███─██████─▄████─▄█▀███─███─███▀█─▄─█"
        },
        {
      "type": "title",
      "format": "█▄▄▄███▄▄█▄▄█▄▄▄▄▄██▄▄▄████▄▄▄███▄▄▄▄▄██▄▄▄██▄▄▄▄▄█▄█▄█"
        },
       "break",
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "red"
        },
        "break",
        {
            "type": "cpu",
            "key": "󰌢 ┌󰻠 ",
            "keyColor": "red"
        },
        {
            "type": "memory",
            "key": "│ ├ ",
            "keyColor": "red"
        },
        {
            "type": "swap",
            "key": "│ ├󰓡 ",
            "keyColor": "red",
        },
        {
            "type": "gpu",
            "key": "│ ├󰾲 ",
            "keyColor": "red"
        },
        {
            "type": "vulkan",
            "key": "└ └󰂩 ",
            "keyColor": "red"
        },
        "break",
        {
            "type": "board",
            "key": "󰇅 ┌󰚗 ",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "│ ├󰋊 ",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "└ └󰍹 ",
            "keyColor": "green",
            "compactType": "original-with-refresh-rate",
            "preciseRefreshRate": false
        },
        "break",
        {
            "type": "os",
            "key": " ┌ ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "de",
            "key": "󰧨 ┌ ",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "󰧨 ┌󰍁 ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "blue"
        },
        {
            "type": "cursor",
            "key": "│ ├󰆿 ",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "key": "│ ├ ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "command",
            "key": "🖳 ┌󰔟 ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "datetime",
            "key": "│ ├󰃰 ",
            "keyColor": "magenta"
        },
        {
            "type": "processes",
            "key": "└ └ ",
            "keyColor": "magenta"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
